# Database configuration (if applicable later)
# DATABASE_URL=postgresql://user:password@localhost:5432/evidencebridge

# PDF Processing Settings
PDF_MAX_SIZE_MB=10
PDF_MAX_PAGES=20

# Claim Extraction Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAIM_EXTRACTION_MAX_CHARS=50000

# Anakin API configuration
ANAKIN_API_KEY=
ANAKIN_SEARCH_LIMIT=5
ANAKIN_TIMEOUT_SECONDS=30

# Research Planner Settings
RESEARCH_MAX_QUERIES=5

# App configuration
ENVIRONMENT=development
LOG_LEVEL=info
